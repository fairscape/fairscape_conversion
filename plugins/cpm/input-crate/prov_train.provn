    activity(ns_training:trainGenerator, -, -, [data_source="train", sampler="rationai.datagens.samplers.RandomTreeSampler", augmenter="rationai.datagens.augmenters.ImageAugmenter", extractor="rationai.datagens.extractors.OpenslideExtractor", generator="rationai.datagens.generators.BaseGeneratorKeras"])
