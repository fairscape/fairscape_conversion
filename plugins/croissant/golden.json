  "@type": "sc:Dataset",
  "name": "Mini_Project",
  "description": "RO-Crate packaging of the CFDE C2M2 Frictionless datapackage for the input-datapackage dataset. It preserves the C2M2 relational tables (TSV), the datapackage schema, and the SQLite relational index verbatim, and overlays schema.org/EVI provenance plus file-level links back to the source data. The relational contract (primary/foreign keys) travels as cfde:* extension fields so the C2M2 relational model can be reconstituted.",
  "dct:conformsTo": "http://mlcommons.org/croissant/RAI/1.0",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "keywords": [
    "CFDE",
    "C2M2",
    "input-datapackage",
    "metadata",
    "RO-Crate",
    "Frictionless",
    "provenance"
  ],
