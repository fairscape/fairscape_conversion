  "rules": {
    "plot_quals": {
      "source": "\"\"\"Plot the quality-score distribution of the called variants.\n\nSnakemake runs this with a ``snakemake`` object in scope carrying the rule's\ninput and output paths \u2014 which is also why the crate records this file as the\nrule's Software rather than a shell command.\n\"\"\"\n\nimport matplotlib\n\nmatplotlib.use(\"Agg\")\n\nimport matplotlib.pyplot as plt\nfrom pysam import VariantFile\n\nquals = [record.qual for record in VariantFile(snakemake.input[0])]\n\nfigure, axes = plt.subplots(figsize=(6, 4))\naxes.hist(quals, bins=30, color=\"#3b6ea5\", edgecolor=\"white\")\naxes.set_xlabel(\"variant quality (Phred)\")\naxes.set_ylabel(\"variants\")\naxes.set_title(f\"{len(quals)} variants called across all samples\")\nfigure.tight_layout()\nfigure.savefig(snakemake.output[0])\n",
      "language": "python",
      "container_img_url": null,
      "conda_env": {
        "channels": [
          "conda-forge",
          "bioconda"
        ],
        "dependencies": [
          "python =3.11",
          "pysam =0.24.1",
          "matplotlib =3.10"
        ]
      },
      "definition_kind": "script",
      "definition_ref": "scripts/plot_quals.py"
    },
    "bcftools_call": {
      "source": "(bcftools mpileup {params.mpileup} -f {input.genome} {input.bam} | bcftools call {params.call} -o {output}) 2> {log}",
      "language": "bash",
      "container_img_url": null,
      "conda_env": {
        "channels": [
          "conda-forge",
          "bioconda"
