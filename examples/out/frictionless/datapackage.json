{
  "profile": "data-package",
  "name": "seasonal-respiratory-illness-survey",
  "title": "Seasonal respiratory illness survey",
  "description": "REDCap project 'Seasonal respiratory illness survey': its data dictionary (21 fields over 3 form(s)) as an EVI schema, with the exported records",
  "version": "1.0",
  "created": "2026-01-20",
  "keywords": [
    "redcap",
    "survey",
    "public health",
    "respiratory"
  ],
